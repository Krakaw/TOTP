#!/bin/bash

set -e

# Get the directory where this script is located
# Resolve symlinks to get the actual script location
# Use readlink -f if available (Linux), otherwise resolve manually
if command -v readlink >/dev/null 2>&1 && readlink -f / >/dev/null 2>&1; then
    # Linux-style readlink -f
    SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
else
    # macOS/BSD or manual resolution
    SCRIPT_SOURCE="${BASH_SOURCE[0]}"
    # Resolve symlinks
    while [ -L "$SCRIPT_SOURCE" ]; do
        SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
        SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
        # If relative symlink, resolve relative to the directory
        [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
    done
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
fi
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Change to project root
cd "$PROJECT_ROOT"

# Run cargo fmt
echo "Running cargo fmt..."
cargo fmt

# Run cargo clippy with warnings as errors
echo "Running cargo clippy..."
cargo clippy -- -D warnings

# Check for global git pre-commit hook and run it AFTER our checks
# First, check if git config has a global hooksPath set
GLOBAL_HOOKS_PATH=$(git config --global --get core.hooksPath 2>/dev/null || true)

if [ -n "$GLOBAL_HOOKS_PATH" ]; then
    GLOBAL_PRE_COMMIT="$GLOBAL_HOOKS_PATH/pre-commit"
    if [ -f "$GLOBAL_PRE_COMMIT" ] && [ -x "$GLOBAL_PRE_COMMIT" ]; then
        echo "Running global pre-commit hook: $GLOBAL_PRE_COMMIT"
        "$GLOBAL_PRE_COMMIT" || exit 1
    fi
fi

# Also check standard global hook locations
GLOBAL_HOOK_LOCATIONS=(
    "$HOME/.git-templates/hooks/pre-commit"
    "/etc/git-core/templates/hooks/pre-commit"
    "/usr/share/git-core/templates/hooks/pre-commit"
)

for global_hook in "${GLOBAL_HOOK_LOCATIONS[@]}"; do
    if [ -f "$global_hook" ] && [ -x "$global_hook" ]; then
        echo "Running global pre-commit hook: $global_hook"
        "$global_hook" || exit 1
    fi
done

echo "Pre-commit checks passed!"
